    {
      "id": "BuTUAgJdk3QC6cmtTtxYE",
      "type": "text",
      "x": 1920,
      "y": -2180,
      "width": 832,
      "height": 600,
      "angle": 0,
      "strokeColor": "#1e1e1e",
