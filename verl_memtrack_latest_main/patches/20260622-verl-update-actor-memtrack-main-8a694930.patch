 logger.setLevel(os.getenv("VERL_LOGGING_LEVEL", "WARN"))
 
 
+def _update_actor_mem_enabled() -> bool:
+    return os.getenv("VERL_UPDATE_ACTOR_MEM", "0") == "1"
+
+
+def _extract_step(data: TensorDict | None) -> str:
+    if data is None:
+        return "unknown"
+    step = tu.get(data, "global_steps", default=None)
+    return "unknown" if step is None else str(step)
+
+
+def _log_update_actor_mem(point: str, rank: int, step: str) -> None:
+    if not _update_actor_mem_enabled():
+        return
+    try:
+        npu = getattr(torch, "npu", None)
+        if npu is None:
+            raise RuntimeError("torch.npu is unavailable")
+        free_bytes, total_bytes = npu.mem_get_info()
+        used_bytes = total_bytes - free_bytes
+        print(
+            (
+                f"[update_actor_mem] point={point} step={step} pid={os.getpid()} "
+                f"rank={rank} local_rank={os.getenv('LOCAL_RANK', 'unknown')} "
+                f"free={free_bytes / (1024**3):.2f} GiB "
+                f"used={used_bytes / (1024**3):.2f} GiB "
+                f"total={total_bytes / (1024**3):.2f} GiB"
+            ),
+            flush=True,
+        )
+    except Exception as exc:
+        print(
+            (
+                f"[update_actor_mem_failed] point={point} step={step} pid={os.getpid()} "
+                f"rank={rank} local_rank={os.getenv('LOCAL_RANK', 'unknown')} "
+                f"reason={type(exc).__name__}: {exc}"
+            ),
+            flush=True,
+        )
+
+
 def _with_routing_replay_flag(enabled: bool):
     """Decorator to set 'enable_routing_replay' flag on the data TensorDict."""
 
