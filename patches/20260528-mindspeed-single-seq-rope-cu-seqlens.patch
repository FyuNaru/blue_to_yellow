+def _maybe_rebuild_single_seq_cu_seqlens_for_rope(
+    t: Tensor,
+    cu_seqlens: Optional[Tensor],
+    cp_group: torch.distributed.ProcessGroup = None,
+) -> Optional[Tensor]:
+    if cu_seqlens is None or cu_seqlens.numel() != 2:
+        return cu_seqlens
+
+    cp_size = cp_group.size() if cp_group is not None else 1
+    local_seqlen = (cu_seqlens[1] - cu_seqlens[0]) // cp_size
+    if int(local_seqlen.item()) == t.size(0):
+        return cu_seqlens
+
+    rebuilt = cu_seqlens.clone()
+    rebuilt[1] = rebuilt[0] + t.size(0) * cp_size
+    return rebuilt
+
+
 
